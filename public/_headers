# Cloudflare Pages headers

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Fingerprinted build output — safe to cache forever
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable
/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

# Media and fonts change rarely
/assets/img/*
  Cache-Control: public, max-age=604800
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/video/*
  Cache-Control: public, max-age=604800
# Documents are NOT fingerprinted, and some are replaced in place under the same
# filename (canteen menu, handbooks), so they cannot be immutable. A day of
# freshness plus a week of background revalidation stops yearbooks and the
# prospectus re-downloading on every repeat visit, without stranding a replaced
# file behind a long max-age.
/assets/docs/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
