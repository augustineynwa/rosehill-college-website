# Cloudflare Pages headers

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Fingerprinted build output — safe to cache forever
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable
/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

# Media and fonts change rarely
/assets/img/*
  Cache-Control: public, max-age=604800
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/video/*
  Cache-Control: public, max-age=604800
# Documents are NOT fingerprinted: staff replace a PDF in place under the same
# filename, so a browser must never reuse one without checking first. Any
# max-age here strands the old copy for that long, which is exactly what happened
# with an earlier max-age=86400 setting.
#
# `no-cache` does not mean "do not store". The browser keeps the file and
# revalidates it against its ETag, so an unchanged PDF costs one conditional
# request answered 304 with no body, and a replaced PDF is picked up straight
# away. The yearbooks still avoid re-downloading 14MB on a repeat visit.
/assets/docs/*
  Cache-Control: public, no-cache
