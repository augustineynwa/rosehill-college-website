<section class="band {{#if pad}}band--{{pad}}{{/if}}" {{#if id}}id="{{id}}"{{/if}} {{#if theme}}data-theme="{{theme}}"{{/if}}>
  <div class="container">
    {{> section-head}}
    <div class="vacancy-list col-narrow" data-vacancies data-feed="{{#if feed}}{{feed}}{{else}}https://tracking.rosehillcollege.school.nz/api/v1/careers/x/vacancies{{/if}}">
      <p class="vacancy-list__status caption" data-vacancies-status>Loading current vacancies…</p>
      <noscript><p>Vacancies are advertised here as they arise. Please contact the school office to ask about current openings.</p></noscript>
    </div>
  </div>
</section>
